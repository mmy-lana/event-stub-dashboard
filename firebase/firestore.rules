rules_version = '2';

// Firestore rules for the local emulator suite.
//
// Emulator baseline: the dashboard demo runs without an organizer sign-in flow,
// so every collection is readable/writable from the client. The hardened rule set
// that scopes reads to organizer claims, limits attendee writes to a matching
// ticket secret or a kiosk operator role and makes the door audit trail
// append-only lives in `firestore.production.rules`.
//
// This file is NOT the default. `firebase.json` names the production set, so a
// bare `firebase deploy` can never ship these open rules to a real project. The
// emulator opts into them explicitly through `firebase.emulator.json`, which
// docker-compose passes as `firebase emulators:start --config`.
//
// Starting the suite without that flag therefore loads the production rules and
// every write fails with permission-denied. Use `pnpm emulator:up`, or pass
// `--config firebase/firebase.emulator.json` when running firebase-tools by hand.
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read, write: if true;

      match /ticketTiers/{tierId} {
        allow read, write: if true;
      }

      match /attendees/{attendeeId} {
        allow read, write: if true;
      }

      match /orders/{orderId} {
        allow read, write: if true;
      }

      match /audit_logs/{auditLogId} {
        allow read, write: if true;
      }
    }
  }
}
